// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  USER
  ADMIN
  GUEST
}

enum MessageSenderRole {
  USER
  BOT
}

/**
 * Discriminates the source of a chat message. TEXT is the default and covers
 * ordinary user text, operator replies and plugin replies. BUTTON marks a
 * message that was created by the user pressing an inline keyboard button —
 * it is visible to the operator console but suppressed from the user's own
 * history and SSE stream (see specs/user-chat).
 */
enum MessageKind {
  TEXT
  BUTTON
}

enum BotPluginTaskStatus {
  PENDING
  PROCESSING
  DONE
}

/**
 * Active language of a user, used by translatable bot features (today only
 * the settings plugin). Members are literally `en`/`ru` (no `@map`): the
 * prisma-client generator emits the member names as the runtime values, so
 * mapping them would make the client send `"EN"` into an `('en','ru')`
 * column. Lowercase members keep DB domain, client type and API wire format
 * the same string.
 */
enum Language {
  en
  ru
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  role           Role     @default(USER)
  isActive       Boolean  @default(true)
  timezone       String?
  language       Language @default(en)
  /**
   * Active Telegram target: null → mock server, otherwise this bot.
   */
  telegramBotId  String?
  /**
   * Telegram chat id bound via deep-link; only meaningful with telegramBotId.
   */
  telegramChatId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  apiKeys      ApiKey[]
  conversation Conversation?
  presets      ButtonPreset[]

  ownedTelegramBots TelegramBot[] @relation("BotOwner")
  telegramBot       TelegramBot?  @relation("UserActiveBot", fields: [telegramBotId], references: [id], onDelete: SetNull)

  @@map("users")
}

model ApiKey {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  senderRole     MessageSenderRole
  kind           MessageKind       @default(TEXT)
  content        String
  /**
   * Immutable snapshot of inline keyboard buttons captured at send time.
   * An array of `{ title, callbackData }`. Kept in the row so later edits
   * or deletion of the source preset never rewrite already-sent messages
   * (Telegram-like semantics). Read-only through `toButtons()`.
   */
  buttons        Json?
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pluginTask   BotPluginTask?

  @@index([conversationId, createdAt])
  @@map("messages")
}

/**
 * Outbox row for bot-plugin dispatch: created in the same transaction as the
 * user message, completed in the same transaction as the plugin reply. Lets
 * the app finish (exactly once) the processing of any message whose dispatch
 * was interrupted by a restart.
 */
model BotPluginTask {
  id        String              @id @default(cuid())
  messageId String              @unique
  status    BotPluginTaskStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("bot_plugin_tasks")
}

/**
 * Reusable named set of inline keyboard buttons owned by an ADMIN user.
 * CRUD happens through `ButtonPresetsService`; the console picks a preset
 * as "active" and attaches its `buttons` array to a bot reply, but the
 * server never stores the "active" pointer — buttons on a `Message` are
 * an independent snapshot (see specs/button-presets: "Снимок кнопок").
 */
model ButtonPreset {
  id        String   @id @default(cuid())
  name      String
  buttons   Json
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("button_presets")
}

/**
 * A real Telegram bot the admin connects via the Bot API. Owner-scoped like
 * `ButtonPreset`: only the creating ADMIN can read/update/delete it, and only
 * the operator's own bots can become a user's active target. `botToken` is a
 * secret masked in every read DTO; `webhookSecret` is never returned and
 * guards the public webhook route. `isActive` gates the whole transport bridge.
 */
model TelegramBot {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  botToken      String
  botUsername   String?
  isActive      Boolean  @default(true)
  webhookSecret String   @default(cuid())
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner User   @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  users User[] @relation("UserActiveBot")

  @@index([ownerId])
  @@map("telegram_bots")
}

/**
 * One-time binding token issued when a user launches their assigned bot. The
 * deep-link `t.me/<botUsername>?start=<token>` carries it; when the bot
 * receives `/start <token>` over the webhook it is spent to attach the
 * Telegram `chat id` to the user.
 */
model TelegramBindingToken {
  id            String    @id @default(cuid())
  token         String    @unique
  userId        String
  telegramBotId String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("telegram_binding_tokens")
}
