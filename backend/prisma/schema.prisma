// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  USER
  ADMIN
  GUEST
}

enum MessageSenderRole {
  USER
  BOT
}

/**
 * Discriminates the source of a chat message. TEXT is the default and covers
 * ordinary user text, operator replies and plugin replies. BUTTON marks a
 * message that was created by the user pressing an inline keyboard button —
 * it is visible to the operator console but suppressed from the user's own
 * history and SSE stream (see specs/user-chat).
 */
enum MessageKind {
  TEXT
  BUTTON
}

/**
 * Transport channel snapshot of a message, taken at write time. For USER
 * messages it is where the user wrote from; for BOT messages it is where
 * the reply was delivered (web-only/mock target vs a real Telegram bot).
 * Null marks messages recorded before this snapshot existed.
 */
enum MessageChannel {
  WEB
  TELEGRAM
}

enum BotPluginTaskStatus {
  PENDING
  PROCESSING
  DONE
}

/**
 * Active language of a user, used by translatable bot features (today only
 * the settings plugin). Members are literally `en`/`ru` (no `@map`): the
 * prisma-client generator emits the member names as the runtime values, so
 * mapping them would make the client send `"EN"` into an `('en','ru')`
 * column. Lowercase members keep DB domain, client type and API wire format
 * the same string.
 */
enum Language {
  en
  ru
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  role           Role     @default(USER)
  isActive       Boolean  @default(true)
  timezone       String?
  language       Language @default(en)
  /**
   * Active Telegram target: null → mock server, otherwise this bot.
   */
  telegramBotId  String?
  /**
   * Telegram chat id bound via deep-link; only meaningful with telegramBotId.
   */
  telegramChatId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  apiKeys      ApiKey[]
  conversation Conversation?
  presets      ButtonPreset[]
  taxiOrders   TaxiOrder[]

  ownedTelegramBots TelegramBot[] @relation("BotOwner")
  telegramBot       TelegramBot?  @relation("UserActiveBot", fields: [telegramBotId], references: [id], onDelete: SetNull)

  @@map("users")
}

model ApiKey {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id                String            @id @default(cuid())
  conversationId    String
  senderRole        MessageSenderRole
  kind              MessageKind       @default(TEXT)
  content           String
  /**
   * Immutable snapshot of inline keyboard buttons captured at send time.
   * An array of `{ title, callbackData }`. Kept in the row so later edits
   * or deletion of the source preset never rewrite already-sent messages
   * (Telegram-like semantics). Read-only through `toButtons()`.
   */
  buttons           Json?
  /**
   * Channel snapshot at write time: for USER messages — where the user wrote
   * from; for BOT messages — where the reply was delivered (see
   * MessageChannelService, which mirrors the Telegram bridge gate).
   * Null for messages recorded before this snapshot existed.
   */
  channel           MessageChannel?
  /**
   * Snapshot of the Telegram bot name for the channel event: the bot that
   * received a USER message or delivered a BOT reply. Null for WEB.
   */
  botName           String?
  /**
   * Snapshot of the console operator's email for BOT replies sent from the
   * mock-bot console; null for plugin auto-replies and all USER messages.
   */
  operatorEmail     String?
  /**
   * Optional reference to the message this reply quotes: an operator reply
   * sent via the console "Reply" action links the USER message it answers.
   * A reference, not a copy — the quote snapshot is joined at read time.
   * The reply itself never disappears; only the quote would (SetNull).
   */
  replyToId         String?
  /**
   * Snapshot of the Telegram `message_id`. On inbound USER rows it is taken
   * from the update and lets a reply reference the exact Telegram message
   * (`reply_to_message_id`); on BOT rows the bridge stores the id of the
   * delivered message after sending, so plugin edit-in-place events are
   * delivered via `editMessageText` (design D12). Null for WEB messages and
   * rows written before the snapshot existed.
   */
  telegramMessageId Int?
  readAt            DateTime?
  createdAt         DateTime          @default(now())

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pluginTask   BotPluginTask?
  replyTo      Message?       @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]      @relation("MessageReply")

  @@index([conversationId, createdAt])
  @@map("messages")
}

/**
 * Outbox row for bot-plugin dispatch: created in the same transaction as the
 * user message, completed in the same transaction as the plugin reply. Lets
 * the app finish (exactly once) the processing of any message whose dispatch
 * was interrupted by a restart.
 */
model BotPluginTask {
  id        String              @id @default(cuid())
  messageId String              @unique
  status    BotPluginTaskStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("bot_plugin_tasks")
}

/**
 * Reusable named set of inline keyboard buttons owned by an ADMIN user.
 * CRUD happens through `ButtonPresetsService`; the console picks a preset
 * as "active" and attaches its `buttons` array to a bot reply, but the
 * server never stores the "active" pointer — buttons on a `Message` are
 * an independent snapshot (see specs/button-presets: "Снимок кнопок").
 */
model ButtonPreset {
  id        String   @id @default(cuid())
  name      String
  buttons   Json
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("button_presets")
}

/**
 * A real Telegram bot the admin connects via the Bot API. Owner-scoped like
 * `ButtonPreset`: only the creating ADMIN can read/update/delete it, and only
 * the operator's own bots can become a user's active target. `botToken` is a
 * secret masked in every read DTO; `webhookSecret` is never returned and
 * guards the public webhook route. `isActive` gates the whole transport bridge.
 */
model TelegramBot {
  id            String   @id @default(cuid())
  ownerId       String
  name          String
  botToken      String
  botUsername   String?
  isActive      Boolean  @default(true)
  webhookSecret String   @default(cuid())
  settings      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner User   @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  users User[] @relation("UserActiveBot")

  @@index([ownerId])
  @@map("telegram_bots")
}

/**
 * One-time binding token issued when a user launches their assigned bot. The
 * deep-link `t.me/<botUsername>?start=<token>` carries it; when the bot
 * receives `/start <token>` over the webhook it is spent to attach the
 * Telegram `chat id` to the user.
 */
model TelegramBindingToken {
  id            String    @id @default(cuid())
  token         String    @unique
  userId        String
  telegramBotId String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("telegram_binding_tokens")
}

/**
 * Status of a taxi order. DRAFT is the wizard's single per-user draft row
 * (never visible in the admin orders list); NEW/CONFIRMED hold the assigned
 * car busy; COMPLETED/CANCELLED free the car for the next assignment.
 */
enum TaxiOrderStatus {
  DRAFT
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

/**
 * Populated area along the taxi route with its km marker from the first
 * point; `distanceKm` drives the price-matrix auto-calc (see change
 * add-taxi-plugin, design D1/D5).
 */
model TaxiCity {
  id         String   @id @default(cuid())
  name       String   @unique
  distanceKm Int
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pricesFrom TaxiCityPrice[] @relation("PriceFrom")
  pricesTo   TaxiCityPrice[] @relation("PriceTo")
  ordersFrom TaxiOrder[]     @relation("OrderFrom")
  ordersTo   TaxiOrder[]     @relation("OrderTo")

  @@map("taxi_cities")
}

/**
 * Extra service selectable in the taxi wizard with its surcharge.
 * `isCarFeature` marks services that require car equipment (child seat,
 * smoking, …): cars declare which of them they provide, and the assignment
 * service matches them (design D11). Non-feature services never restrict
 * car selection.
 */
model TaxiExtraService {
  id           String   @id @default(cuid())
  name         String   @unique
  surcharge    Int
  isActive     Boolean  @default(true)
  isCarFeature Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cars TaxiCar[] @relation("CarFeatures")

  @@map("taxi_extra_services")
}

/**
 * Price of one unordered city pair; rows are stored normalized
 * (`fromCityId < toCityId` lexicographically) so the pair is symmetric by
 * construction — see design D6.
 */
model TaxiCityPrice {
  id        String   @id @default(cuid())
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromCity TaxiCity @relation("PriceFrom", fields: [fromCityId], references: [id], onDelete: Cascade)
  toCity   TaxiCity @relation("PriceTo", fields: [toCityId], references: [id], onDelete: Cascade)

  fromCityId String
  toCityId   String

  @@unique([fromCityId, toCityId])
  @@map("taxi_city_prices")
}

/**
 * Recurring daily departure time offered by the wizard (`HH:MM`).
 */
model TaxiDepartureSlot {
  id        String   @id @default(cuid())
  time      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders TaxiOrder[]

  @@map("taxi_departure_slots")
}

/**
 * Passenger-count option offered by the wizard.
 */
model TaxiPassengerOption {
  id        String   @id @default(cuid())
  count     Int      @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("taxi_passenger_options")
}

/**
 * Driver managed by the admin; deleting a driver deletes his cars.
 */
model TaxiDriver {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars TaxiCar[]

  @@map("taxi_drivers")
}

/**
 * Car of one driver. `seats` is the required capacity matched against the
 * passenger count; `features` (m-n to car-feature services) declares the
 * equipment the car provides (design D11).
 */
model TaxiCar {
  id        String   @id @default(cuid())
  model     String
  plate     String   @unique
  color     String?
  seats     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver   TaxiDriver         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String
  features TaxiExtraService[] @relation("CarFeatures")

  orders TaxiOrder[]

  @@map("taxi_cars")
}

/**
 * Taxi order. Doubles as the wizard state machine row: `status: DRAFT` with
 * `draftStep` tracks wizard progress; `serviceIds` holds the draft's selected
 * extra-service ids. On confirmation the row flips to NEW and stores an
 * immutable snapshot (names, services with surcharges, car, prices) so later
 * dictionary edits never change past orders (design D4/D11). `carId` keeps
 * the assigned car busy while NEW/CONFIRMED (SetNull on car deletion — display
 * relies on the snapshot).
 */
model TaxiOrder {
  id                 String          @id @default(cuid())
  userId             String
  status             TaxiOrderStatus @default(DRAFT)
  draftStep          Int             @default(1)
  passengerCount     Int?
  serviceIds         Json?
  priceBase          Int?
  priceTotal         Int?
  fromCityName       String?
  toCityName         String?
  departureSlotLabel String?
  serviceSnapshot    Json?
  carSnapshot        Json?
  confirmedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCity      TaxiCity?          @relation("OrderFrom", fields: [fromCityId], references: [id], onDelete: Restrict)
  toCity        TaxiCity?          @relation("OrderTo", fields: [toCityId], references: [id], onDelete: Restrict)
  departureSlot TaxiDepartureSlot? @relation(fields: [departureSlotId], references: [id], onDelete: SetNull)
  car           TaxiCar?           @relation(fields: [carId], references: [id], onDelete: SetNull)

  fromCityId      String?
  toCityId        String?
  departureSlotId String?
  carId           String?

  @@index([userId, status])
  @@index([status, carId])
  @@map("taxi_orders")
}
