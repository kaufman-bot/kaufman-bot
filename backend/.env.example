DATABASE_URL="postgresql://kaufman:kaufman@localhost:5432/kaufman_bot?schema=public"
PORT=3000

# Default admin credentials
ADMIN_EMAIL=admin@kaufman.bot
ADMIN_PASSWORD=change-me
ADMIN_API_KEY=change-me

# Default USER #1 credentials
USER1_EMAIL=user1@kaufman.bot
USER1_PASSWORD=change-me
USER1_API_KEY=change-me

# Default USER #2 credentials
USER2_EMAIL=user2@kaufman.bot
USER2_PASSWORD=change-me
USER2_API_KEY=change-me

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=29000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false

# Telegram integration (real Bot API via grammy)
# Public HTTPS origin that Telegram delivers webhooks to. Each enabled bot
# self-registers ${TELEGRAM_WEBHOOK_BASE_URL}/api/telegram/webhook/<botId> at
# startup (best-effort). Empty → webhook registration is skipped with a
# warning; the message bridge is still exercised by unit tests.
TELEGRAM_WEBHOOK_BASE_URL=
